# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your keys are never uploaded to GitHub.

ASSISTANT_NAME=Jarvis
WAKE_WORD=jarvis
USER_NAME=Sir

VOICE_INDEX=0
SPEECH_RATE=175

# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
DEFAULT_CITY=London

REQUIRE_WAKE_WORD=true
PHRASE_TIME_LIMIT=6
